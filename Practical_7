@model IEnumerable<FeedbackManagementApp.Models.Feedback>

@{
    ViewData["Title"] = "Feedback Dashboard";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Feedback Dashboard</h2>
            <p class="text-muted">
                View and analyze customer feedback.
            </p>
        </div>

        <a asp-controller="Feedback"
           asp-action="Create"
           class="btn btn-primary">
            + Add Feedback
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3
                        text-center rounded-3 h-100">
                <span class="text-muted text-uppercase fw-bold small">
                    Total Responses
                </span>
                <h2 class="fw-bold text-primary m-0 mt-2">
                    @ViewBag.TotalCount
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3
                        text-center rounded-3 h-100">
                <span class="text-muted text-uppercase fw-bold small">
                    Average Rating
                </span>
                <h2 class="fw-bold text-warning m-0 mt-2">
                    @(((double)ViewBag.AverageRating).ToString("0.0"))
                    <small class="fs-6 text-muted">/ 5</small>
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3
                        text-center rounded-3 h-100">
                <span class="text-muted text-uppercase fw-bold small">
                    Positive Sentiment (4★ &amp; 5★)
                </span>
                <h2 class="fw-bold text-success m-0 mt-2">
                    @(((double)ViewBag.PositivePercentage).ToString("0.0"))%
                </h2>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Customer Responses</h5>
        </div>

        <div class="card-body">
            @if (Model.Any())
            {
                foreach (var feedback in Model)
                {
                    <partial name="_FeedbackItem" model="feedback" />
                }
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-muted">
                        No feedback available yet.
                    </h5>
                    <p>Be the first person to share your experience.</p>

                    <a asp-controller="Feedback"
                       asp-action="Create"
                       class="btn btn-primary">
                        Submit Feedback
                    </a>
                </div>
            }
        </div>
    </div>

</div>


// ============================================================
// FILE: Views/Feedback/_FeedbackItem.cshtml
// ============================================================

@model FeedbackManagementApp.Models.Feedback

<div class="card border rounded-3 mb-3">
    <div class="card-body">

        <div class="d-flex justify-content-between
                    align-items-start flex-wrap gap-2">

            <div>
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <span class="badge bg-primary">@Model.Category</span>
            </div>

            <div class="text-warning fs-5"
                 aria-label="@Model.Rating out of 5 stars">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Model.Rating)
                    {
                        <span>★</span>
                    }
                    else
                    {
                        <span class="text-secondary">☆</span>
                    }
                }
            </div>
        </div>

        <p class="card-text my-3 text-secondary"
           style="white-space: pre-line;">@Model.Comments</p>

        <div class="d-flex justify-content-between
                    align-items-center text-muted small pt-2 border-top">
            <span><strong>Email:</strong> @Model.Email</span>
            <span>Feedback ID: @Model.Id</span>
        </div>

    </div>
</div>


